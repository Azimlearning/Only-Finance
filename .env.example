# Copy to .env.local (repo root) and fill in. Never commit .env.local.
# Both are optional: without them the app runs with offline AI templates.

# Server-side only: read by app/vite.config.ts for the /api/llm proxy. No VITE_ prefix.
OPENROUTER_API_KEY=

# Not secret: an OpenRouter model id that supports tool calling.
VITE_OPENROUTER_MODEL=
